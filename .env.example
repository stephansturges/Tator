# Runtime configuration

# CLIP backbone (e.g., ViT-B/32, RN50)
# CLIP_MODEL_NAME=ViT-B/32

# Path to trained logistic regression
# LOGREG_PATH=./my_logreg_model.pkl

# SAM configuration
# SAM_MODEL_TYPE=vit_h
# SAM_CHECKPOINT_PATH=./sam_vit_h_4b8939.pth
# SAM_VARIANT=sam1
# SAM3_MODEL_ID=facebook/sam3
# SAM3_PROCESSOR_ID=facebook/sam3
# SAM3_CHECKPOINT_PATH=
# SAM3_DEVICE=auto

# Default inference device selection (auto|cpu|cuda|cuda:0|mps)
# TATOR_INFERENCE_DEVICE=auto
# TATOR_ALLOW_MPS=1
# PYTORCH_ENABLE_MPS_FALLBACK=1

# Legacy device override. Prefer TATOR_INFERENCE_DEVICE for new setups.
# FORCE_DEVICE=

# Falcon automatic-labeling
# FALCON_PERCEPTION_MODEL_ID=tiiuae/Falcon-Perception
# FALCON_PERCEPTION_DEVICE=cuda:0
# FALCON_PERCEPTION_LOCAL_ONLY=1

# Qwen
# QWEN_MODEL_NAME=Qwen/Qwen3-VL-4B-Instruct
# QWEN_DEVICE=auto
# QWEN_MAX_NEW_TOKENS=768

# CORS (comma-separated exact origins). Same-origin and local development work
# without this. "*" is intentionally not the default and is unsafe on a shared
# backend.
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8080

# Protect the opt-in human-training corpus when the API is reached directly
# over a LAN/tailnet rather than through loopback.
# TATOR_TRAINING_DATA_TOKEN=replace-with-a-long-random-value

# When using Tailscale Serve to proxy the loopback backend, allow exact user
# logins and/or one app-capability name injected by the trusted Serve proxy.
# TATOR_TRAINING_CAPTURE_TAILSCALE_USERS=you@example.com
# TATOR_TRAINING_CAPTURE_TAILSCALE_CAPABILITY=example.com/cap/tator-training

# Enable Prometheus /metrics endpoint and middleware timings
# ENABLE_METRICS=false
