# Copy to /etc/tator/hosted.env, owned by root:tator and mode 0640.
# Choose a NEW state directory. Do not point this at an existing dataset root.
TATOR_HOSTED_STATE_DIR=/var/lib/tator-hosted
TATOR_HOSTED_ORIGIN=https://replace-with-server-and-tailnet.ts.net
TATOR_HOSTED_MODEL_CONFIG=/etc/tator/models.json
# Optional, operator-verified prices and token limits. Contains no API keys.
# TATOR_HOSTED_PROVIDER_PRICING=/etc/tator/provider-pricing.json
# Optional admin workbench: the full legacy tools for administrators. Both are
# needed together; see docs/hosted_workbench.rst and tator-workbench.service.
# TATOR_HOSTED_WORKBENCH_URL=unix:/run/tator-workbench/api.sock
# TATOR_HOSTED_WORKBENCH_ROOT=/var/lib/tator-workbench
